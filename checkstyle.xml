<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="com.puppycrawl.tools.checkstyle.Checker">
    <module name="SuppressionFilter">
        <property name="file" value="checkstyle-suppressions.xml"/>
    </module>
    <module name="io.spring.javaformat.checkstyle.SpringChecks">
        <!-- The project's own license header (checkstyle-header.txt) in place of the Spring default. -->
        <property name="headerFile" value="checkstyle-header.txt"/>
        <property name="headerCopyrightPattern" value="20\d\d(-20\d\d|-present)?"/>
    </module>
</module>
