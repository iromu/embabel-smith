<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.iromu.embabel.smith</groupId>
        <artifactId>embabel-smith-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>embabel-smith-poc</artifactId>
    <packaging>pom</packaging>
    <name>Embabel Smith POCs</name>
    <description>
        Aggregator for the POC modules. Each module is a numbered proof of one aspect of the
        "specs, not agents" hypothesis (POC 1-11); see docs/04-poc-run-results.md.
    </description>

    <modules>
        <module>poc-1-no-code-runtime</module>
        <module>poc-2-nl-compile</module>
        <module>poc-3-builder-agent</module>
        <module>poc-4-agent-spec-format</module>
        <module>poc-5-eval</module>
        <module>poc-6-agent-spec-composition</module>
        <module>poc-7-runtime-adapter</module>
        <module>poc-8-retrieval</module>
        <module>poc-9-quality-refinement</module>
        <module>poc-10-trust-tiers</module>
        <module>poc-11-progressive-disclosure</module>
        <module>poc-12-semantic-retrieval</module>
        <module>poc-13-remote-mcp</module>
        <module>poc-14-composer</module>
        <module>poc-15-composer-ui</module>
        <module>poc-16-remote-action</module>
        <module>poc-17-gliner-retrieval</module>
        <module>poc-18-agent-spec-lifecycle</module>
        <module>poc-19-small-llm-selector</module>
        <module>poc-20-semantic-embedding</module>
        <module>poc-21-agent-spec-security</module>
        <module>poc-22-unified-ui</module>
        <module>poc-23-remote-embedding-scale</module>
        <module>poc-24-generation-approaches</module>
        <module>poc-25-skill-generation</module>
        <module>poc-26-graaljs-skill-scripts</module>
        <module>poc-27-recursive-self-improvement</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-1-no-code-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-2-nl-compile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-8-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-9-quality-refinement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-12-semantic-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-14-composer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-17-gliner-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-18-agent-spec-lifecycle</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-20-semantic-embedding</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- POC 21 reuses POC 10's trust tiers for its recommended-load-tier computation. -->
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-10-trust-tiers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-21-agent-spec-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Remote transports (POC 22 Remote pane): the RestAction sidecar and the MCP server. -->
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-13-remote-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-16-remote-action</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- POC 27 runs its generated improvement policies through POC 26's in-JVM script engine. -->
            <dependency>
                <groupId>org.iromu.embabel.smith</groupId>
                <artifactId>poc-26-graaljs-skill-scripts</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
