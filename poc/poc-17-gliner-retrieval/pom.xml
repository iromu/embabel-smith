<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.embabel.smith</groupId>
        <artifactId>embabel-smith-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>poc-17-gliner-retrieval</artifactId>
    <name>poc-17-gliner-retrieval</name>
    <description>
        POC 17: GLiNER2 transformer skill classification. Runs a real zero-shot transformer
        classifier (GLiNER2 via GLiNER4j over ONNX Runtime) on the same within-topic
        skill-shadowing scenario POC 12 measured, to test whether a model that understands
        meaning — rather than matching hashed n-grams — breaks the tie that lexical and dense
        text-similarity cannot. A local-model-gated benchmark: the three-method comparison runs
        when the ONNX bundle is present; offline unit tests mock the classifier so the module
        stays green without it.
    </description>

    <dependencies>
        <!-- Reuse POC 12's ScaleSkillLibrary (6 targets + near-duplicates) and POC 8/12's
             LexicalSimilarity / SemanticSimilarity as the two baselines. -->
        <dependency>
            <groupId>com.embabel.smith</groupId>
            <artifactId>poc-12-semantic-retrieval</artifactId>
        </dependency>

        <!-- GLiNER2 zero-shot transformer classifier over ONNX Runtime (CPU). -->
        <dependency>
            <groupId>io.gravitee.ai.gliner4j</groupId>
            <artifactId>gliner4j-core</artifactId>
            <version>1.1.1</version>
        </dependency>
        <!-- gliner4j-core declares onnxruntime as provided; supply the CPU execution provider. -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.27.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.embabel.smith.retrieval.gliner.GlinerRetrievalApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
