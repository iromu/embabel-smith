EvalSuite[skillName=run-configuration-and-validation, evals=[Eval[id=1, prompt=Configure a run for ticker 'BTC-USD' on date '2023-10-25' with analysts ['Technical', 'Fundamentals', 'Sentiment'], depth 'deep', model 'gpt-4', language 'en', no holdings, resume false. The 'Fundamentals' analyst is selected for a crypto asset., expectedOutput=The system must reject the configuration due to the invalid combination of a crypto instrument and the Fundamentals Analyst., files=[], expectations=[Must identify 'BTC-USD' as a crypto instrument., Must flag the selection of 'Fundamentals' analyst as invalid for crypto assets., Must not output a valid run configuration object., Must provide a clear error message explaining the crypto/Fundamentals constraint violation.]], Eval[id=2, prompt=Configure a run for ticker 'AAPL' on date '2024-12-31' (today is 2024-05-20) with analysts ['Technical'], depth 'quick', model 'gpt-3.5-turbo', language 'en', no holdings, resume false. The OPENAI_API_KEY environment variable is missing., expectedOutput=The system must reject the configuration due to the future date and missing credentials, listing all missing parameters., files=[], expectations=[Must reject the date '2024-12-31' as a future date relative to the current date., Must detect that OPENAI_API_KEY is missing for the selected model 'gpt-3.5-turbo'., Must stop the run before execution., Must list every missing parameter or invalid input in the error output.]], Eval[id=3, prompt=Resume a run for ticker 'MSFT' on date '2024-05-19' with analysts ['Technical', 'Sentiment'], depth 'deep', model 'gpt-4', language 'en', no holdings, resume true. A saved snapshot exists for this run identity, but the saved snapshot has depth 'quick' while the current request has depth 'deep'., expectedOutput=The system must detect the configuration mismatch and start a fresh run instead of resuming from the snapshot., files=[], expectations=[Must compute the run identity signature including the 'deep' depth., Must compare the current configuration against the saved snapshot., Must detect the mismatch in the 'depth' parameter ('deep' vs 'quick')., Must explicitly state that the run will start fresh rather than resuming., Must output a valid run configuration object for a fresh start.]], Eval[id=4, prompt=Configure a run for ticker '../../etc/passwd' on date '2024-05-20' with analysts ['Technical'], depth 'quick', model 'gpt-3.5-turbo', language 'en', no holdings, resume false., expectedOutput=The system must reject the configuration due to the malformed/unsafe ticker format., files=[], expectations=[Must identify the ticker '../../etc/passwd' as malformed or unsafe., Must reject the configuration due to path-traversal style input., Must not output a valid run configuration object., Must provide a security-related error message regarding the ticker format.]]]]
