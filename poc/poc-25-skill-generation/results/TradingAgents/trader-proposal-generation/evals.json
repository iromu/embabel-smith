EvalSuite[skillName=trader-proposal-generation, evals=[Eval[id=1, prompt=The Research Manager's plan for TSLA is 'Accumulate on dip'. The technical report shows support at $245.00 and resistance at $260.00. The current price is $248.50. The operator's current holding is 500 shares. Generate the transaction proposal., expectedOutput=A Buy proposal with entry price $245.00, stop-loss below support (e.g., $240.00), and position sizing calculated against the 500 share holding., files=[], expectations=[Must output action as 'Buy', Must state entry price as an absolute number (e.g., 245.00), not a percentage or range, Must state stop-loss as an absolute number, not a percentage, Must calculate position sizing based on the existing 500 share holding, Must include reasoning grounded in the technical report's support/resistance levels]], Eval[id=2, prompt=The Research Manager's plan for AAPL is 'Hold'. The technical report indicates neutral momentum. The operator provided holdings data: {'ticker': 'AAPL', 'shares': '1,200', 'avg_cost': '$150.50'}. Generate the transaction proposal., expectedOutput=A Hold proposal with no entry/stop-loss changes, acknowledging the 1,200 share position., files=[], expectations=[Must output action as 'Hold', Must parse '1,200' as the integer 1200 for position sizing context, Must parse '$150.50' as the float 150.50, Must not propose new entry or stop-loss prices if the action is Hold, Must reference the operator's existing position size in the reasoning]], Eval[id=3, prompt=The Research Manager's plan for NVDA is 'Sell'. The technical report shows a breakdown below $400. The operator provided holdings: {'ticker': 'NVDA', 'shares': 'N/A', 'avg_cost': '10% loss'}. Generate the transaction proposal., expectedOutput=A Sell proposal with entry price at current market or below $400, stop-loss not applicable or set to current price, and position sizing guidance for the operator's own position since holdings are malformed., files=[], expectations=[Must output action as 'Sell', Must drop the 'N/A' placeholder for shares and not fail the decision, Must drop the '10% loss' percentage for avg_cost and not fail the decision, Must provide position sizing guidance for the operator's own position since real holdings are unavailable, Must state entry price as an absolute number (e.g., 400.00 or current price), not a percentage]], Eval[id=4, prompt=The Research Manager's plan for MSFT is 'Buy'. The technical report shows support at $300. The operator provided holdings: {'ticker': 'MSFT', 'shares': 100, 'avg_cost': 290}. The current price is $305. Generate the transaction proposal., expectedOutput=A Buy proposal with entry price $300.00, stop-loss below $300, and position sizing adding to the 100 share holding., files=[], expectations=[Must output action as 'Buy', Must state entry price as 300.00 (absolute number), Must state stop-loss as an absolute number below 300.00, Must calculate position sizing against the real position of 100 shares, Must not use percentages for stop-loss or position sizing]]]]
