<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.embabel.smith</groupId>
        <artifactId>embabel-smith-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>poc-19-small-llm-selector</artifactId>
    <name>poc-19-small-llm-selector</name>
    <description>
        POC 19: small-LLM skill selection. Runs a 0.6B model fine-tuned for single-label
        decisions (iromu/Qwen3-0.6B-openjev, Q8_0 GGUF) as a skill selector on the same
        within-topic skill-shadowing scenario POC 17 measured, to test whether a
        sub-billion-parameter LLM breaks the tie that lexical and dense text-similarity
        cannot — and how it compares to the GLiNER2 transformer classifier. The model is
        served in a Docker container (llama.cpp) whose lifecycle Spring Boot Dev Services
        manages from the module's compose.yml. A docker-gated benchmark: the four-method
        comparison runs when Docker and the weights are present; offline unit tests stub
        the model endpoint so the module stays green without Docker.
    </description>

    <dependencies>
        <!-- Reuse POC 17's SkillSelector seam, ShadowingRunner, and the lexical/dense/
             GLiNER2 baseline selectors (transitively POC 12's ScaleSkillLibrary). -->
        <dependency>
            <groupId>com.embabel.smith</groupId>
            <artifactId>poc-17-gliner-retrieval</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Dev Services: manages the model-serving container defined in compose.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
        </dependency>
        <!-- JSON for the OpenAI-compatible /v1 request and reply. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
