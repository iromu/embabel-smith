<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.embabel.smith</groupId>
    <artifactId>embabel-smith-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Embabel Smith</name>
    <description>
        A skills-first Embabel agent builder: a general-purpose builder agent that emits
        deployable, no-code skill-packs, plus the fixed no-code runtime that ingests them.
        Greenfield POC multi-module project on Embabel 1.5.3 / Java 21.
    </description>

    <properties>
        <embabel-agent.version>1.5.3</embabel-agent.version>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <jackson.version>2.19.0</jackson.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <slf4j.version>2.0.13</slf4j.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
    </properties>

    <modules>
        <module>smith-common</module>
        <module>poc</module>
    </modules>

    <repositories>
        <!-- Embabel release binaries (also mirrored on Maven Central). -->
        <repository>
            <id>embabel-releases</id>
            <name>Embabel Releases</name>
            <url>https://repo.embabel.com/artifactory/libs-release</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- Embabel platform starters (pull in the matching Spring Boot). -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-starter</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-starter-openai-custom</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <!-- MCP server publishing: goals annotated @Export(remote=true) become MCP tools. -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-starter-mcpserver</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <!-- MCP client SDK (POC 13 consumes the published server over Streamable HTTP). -->
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp</artifactId>
                <version>2.1.0</version>
            </dependency>
            <!-- Remote-action bridge (POC 16): pull a sidecar's actions in as RestActions. -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-remote</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <!-- The no-compilation YAML ingestion engine + NL compiler. -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-spec</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <!-- LLM eval harness (conversational-oriented; adapted in poc-5-eval). -->
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-eval</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.agent</groupId>
                <artifactId>embabel-agent-test</artifactId>
                <version>${embabel-agent.version}</version>
            </dependency>

            <!-- Smith internal modules. -->
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>smith-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-1-no-code-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-2-nl-compile</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-8-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-9-quality-refinement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-12-semantic-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-14-composer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-17-gliner-retrieval</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.embabel.smith</groupId>
                <artifactId>poc-18-skill-lifecycle</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jackson (used by smith-common for skill-pack YAML I/O). -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Test dependencies. -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- Import the Spring Boot BOM so the POC modules resolve a consistent
                 Spring Boot (4.1.1, the version Embabel 1.5.3 is built against). -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
