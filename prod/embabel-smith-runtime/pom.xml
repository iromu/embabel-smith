<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.iromu.embabel.smith</groupId>
        <artifactId>embabel-smith-prod</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>embabel-smith-runtime</artifactId>
    <name>embabel-smith-runtime</name>
    <description>
        The runtime product: ingests agent specs from a source, runs multi-pack plans
        through the trust gate, emits per-run JSONL traces, and exposes a picocli
        `smith run` CLI. Non-launcher packages are plain classes so embabel-smith-studio reuses them.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>smith-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-specsource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai-custom</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-anthropic</artifactId>
        </dependency>
        <!-- embabel-agent-starter-a2a is deliberately absent from this pom: it belongs to
             embabel-smith-a2a-starter alone, and it brings spring-boot-starter-web plus an
             auto-configuration that registers /a2a on any servlet app that sees it — which
             includes embabel-smith-studio, a consumer of this module. This module cannot
             declare the a2a starter itself either: the starter depends on this module, so
             that edge would be a Maven cycle. The surface reaches a process through the
             studio, or through a host that depends on the starter directly, where the A2A
             starter stays one hop away and inert until smith.a2a.enabled is set. -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-spec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- ChatClientAutoConfiguration's @AutoConfiguration names ToolCallingAutoConfiguration.
             Spring AI marks that jar optional, so it is absent here and the reference dangles: on
             the JVM that is a swallowed TypeNotPresentException, but in the native image the
             dangling class makes annotation parsing fault — a raw segfault, no Java exception —
             while Embabel's structure validator scans the bean annotations of every bean during
             its own afterPropertiesSet. The builder carries the same jar for the same reason; this
             module needs it in its own right because it does not depend on the builder. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-model-tool</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The executable jar, beside the plain one rather than in place of it.

                `repackage` with a classifier writes target/embabel-smith-runtime-<version>-exec.jar
                and leaves the main artifact exactly as it was, so `java -jar` works without changing
                what `mvn install` publishes. The classifier is load-bearing, not cosmetic: this
                module is a compile dependency of embabel-smith-studio and embabel-smith-a2a-starter,
                and a repackaged jar keeps its classes under BOOT-INF/classes where an ordinary
                classpath cannot see them. Repackaging in place would leave both dependents compiling
                against a jar they cannot read.

                The version comes from the root pom's <pluginManagement>, and the Start-Class is
                detected — SmithRuntimeApplication is the module's only main().
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The native `smith-runtime` binary, on the same opt-in the builder uses: the root pom's
            `native` profile holds the shared defaults (the reachability metadata repository and
            the no-fallback build arg), and a module declares the three executions that make an
            image. Without this section the module is untouched by -Pnative.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- process-aot writes its generated classes and reachability metadata to
                         target/spring-aot/main and cleans that directory first, so the two trees are
                         folded into target/classes here — the one place native-image already has on
                         its classpath. Pointing process-aot's own output at target/classes deletes
                         the module's compiled classes instead. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>fold-aot-output</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/spring-aot/main/classes</directory>
                                        </resource>
                                        <resource>
                                            <directory>${project.build.directory}/spring-aot/main/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <imageName>smith-runtime</imageName>
                            <mainClass>com.embabel.smith.runtime.SmithRuntimeApplication</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
