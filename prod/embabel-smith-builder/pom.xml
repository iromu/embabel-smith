<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.iromu.embabel.smith</groupId>
        <artifactId>embabel-smith-prod</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>embabel-smith-builder</artifactId>
    <name>embabel-smith-builder</name>
    <description>
        The standalone builder product: compile → validate → write, eval, bounded refine,
        security gate, and lifecycle metadata; publish to a folder or git source (local
        commit, no push by default). Exposes a picocli `smith build` CLI.
    </description>

    <properties>
        <!-- The GraalJS line this module builds its skill-script engine against, overriding the
             root's graalvm.version (25.4.4.1.1) for these two artifacts only. This is an image
             compatibility constraint, not a preference: native-image fails when the classpath
             Truffle and the distribution's SVM Truffle feature disagree, and the distributions
             this repo builds the shipped artifact with — scripts/native.sh on sdkman 25-graalce
             (GraalVM CE 25+37.1) and .github/workflows/native-image.yml on GRAAL_VERSION 25.0.2
             — are both on the 25.0.x line, whose OptimizedTruffleRuntime exposes the
             getLoopNodeFactory() that SubstrateTruffleRuntime asks for. At 25.4.4.1.1 the build
             dies inside TruffleBaseFeature with a NoSuchMethodError. The root property stays at
             25.4.4.1.1 because poc-26 measured its ES2026 claims on that pair and poc/ is frozen
             evidence, so the divergence is scoped to the module that ships as a binary. Bump it
             only together with the distribution: the pairing, not the number, is what matters. -->
        <graalvm.polyglot.version>25.0.2</graalvm.polyglot.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>smith-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-specsource</artifactId>
        </dependency>
        <!-- Skill authoring checks for the skill target's inspect gate. -->
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-skillevaluator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai-custom</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-spec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-eval</artifactId>
        </dependency>
        <!-- Agent Skills, for the SkillScriptExecutionEngine SPI the in-JVM script engine
             implements (skill/script/). The SPI is the whole reason for the dependency:
             Embabel loads a skill's scripts/ folder itself and asks an installed engine to
             run them, so the builder needs the interface and nothing else from here. -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-skills</artifactId>
        </dependency>
        <!-- Embedded GraalJS: the interpreter that runs those scripts in this JVM, so a
             generated skill's JavaScript needs no Node and no GraalVM on the host. "js" is a
             POM that brings js-language, regex and the Truffle runtime; it runs
             interpreter-only on a plain JDK. Versions are pinned here rather than inherited,
             for the reason in the <properties> block above: the image toolchain, not taste. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.polyglot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js</artifactId>
            <version>${graalvm.polyglot.version}</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <!-- ChatClientAutoConfiguration's @AutoConfiguration names ToolCallingAutoConfiguration.
             Spring AI marks that jar optional, so it is absent here and the reference dangles:
             on the JVM that is a swallowed TypeNotPresentException, but in the native image the
             dangling class makes annotation parsing fault while Embabel's structure validator
             scans bean annotations. Carrying the jar closes the reference. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-autoconfigure-model-tool</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- `smith` as a native binary: AOT-process the Spring context into the module's
             classes, then hand them to native-image. The binary lands at target/smith.
             Nothing here runs without -Pnative. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- process-aot writes its generated classes and reachability metadata to
                         target/spring-aot/main and cleans that directory first, so the two trees
                         are folded into target/classes here — the one place native-image already
                         has on its classpath. (Pointing process-aot's own output at target/classes
                         deletes the module's compiled classes instead.) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>fold-aot-output</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/spring-aot/main/classes</directory>
                                        </resource>
                                        <resource>
                                            <directory>${project.build.directory}/spring-aot/main/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <!-- The pack folder beside the binary. A native image carries resources
                                 as a flat named set with no directory entries, so nothing in the
                                 image can list a pack's directory, however many files are registered
                                 (see builder-native-hints). SpecFolders therefore falls back to the
                                 `specs/` folder next to the running program, and this is what puts it
                                 there — next to target/smith, not inside it, because the route starts
                                 from the executable's own directory rather than the working
                                 directory. The classpath route still answers first wherever it can,
                                 so this copy is inert on a JVM run. -->
                            <execution>
                                <id>pack-specs-beside-binary</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/main/resources/specs</directory>
                                            <targetPath>specs</targetPath>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <imageName>smith</imageName>
                            <mainClass>com.embabel.smith.builder.SmithBuilderApplication</mainClass>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
