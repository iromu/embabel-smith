<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.iromu.embabel.smith</groupId>
        <artifactId>embabel-smith-prod</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>embabel-smith-a2a-starter</artifactId>
    <name>embabel-smith-a2a-starter</name>
    <description>
        The agent-to-agent surface, as a starter library a host depends on: auto-configures
        five A2A (protocol 0.3) operations over the Embabel A2A starter, mapping one A2A task
        onto one embabel-smith-runtime run and one trace record. No launcher, no application
        class and no classpath application.yml of its own — the surface is off until a host
        sets smith.a2a.enabled, and a host that does so gains servlet mode and a default port
        from this module's EnvironmentPostProcessor rather than from a launcher of its own.
        Local development endpoint when enabled: explicit non-default port, no authentication.
        Holds no model call of its own.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-runtime</artifactId>
        </dependency>
        <!-- Declared rather than inherited from the runtime: the card's goal filter reads the
             spec source and its packs directly, so this module uses these two itself. -->
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>smith-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-specsource</artifactId>
        </dependency>
        <!-- The only prod module that declares the A2A starter, and therefore the only one
             that gains spring-boot-starter-web and a servlet engine from it. -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-a2a</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
