<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.iromu.embabel.smith</groupId>
        <artifactId>embabel-smith-prod</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>embabel-smith-studio</artifactId>
    <name>embabel-smith-studio</name>
    <description>
        The self-improving studio product: hosts the runtime and builder, the
        self-improvement loop, the REST surface, and the web UI.
    </description>
    <properties>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <frontend-maven-plugin.nodeVersion>v26.13.1</frontend-maven-plugin.nodeVersion>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>smith-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-specsource</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-runtime</artifactId>
        </dependency>
        <!-- The A2A surface. This module is the repo's servlet host, so it is the module the
             surface is turned on in; it stays inert here unless a run sets
             smith.a2a.enabled. Declared explicitly rather than reached through another
             module, because the studio's contract now includes serving /a2a on request. -->
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-a2a-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.iromu.embabel.smith</groupId>
            <artifactId>embabel-smith-builder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- JPA storage (change: smith-studio-postgres-storage). The datasource and
             EntityManagerFactory are bound programmatically by the storage context (hot-swap),
             so the starter's auto-configurations are excluded in SmithStudioApplication; only the
             Hibernate / Spring-ORM / Spring-Data-JPA APIs and HikariCP are used here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Dev Services: auto-starts the development Postgres from docker-compose.yml when the
             `local` profile is active (see application-local.yaml); disabled by default so a
             packaged run never spawns a container. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>${basedir}/frontend</workingDirectory>
                </configuration>
                <executions>
                    <!--
                        The three npm runs are bound to generate-resources, the plugin's own default
                        phase, and the phase matters more than it looks. Vite writes the bundle into
                        src/main/resources/static (frontend/vite.config.ts), and it is
                        maven-resources-plugin at process-resources that puts that directory into
                        target/classes. Bound to compile — after that copy — a clean single-pass build
                        produced a studio whose classes had no static/ at all: the app booted and 404'd
                        at /, and only the *second* build on a tree looked correct because it copied
                        what the first had generated. Anything that packages this module (the
                        executable jar below, a container image) ships the gap. Running the frontend
                        before the copy makes one build produce what the next build would have had.
                    -->
                    <!-- Install our node and npm version to run npm/node scripts-->
                    <execution>
                        <id>install node</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${frontend-maven-plugin.nodeVersion}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>modules install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>modules update</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>update</arguments>
                        </configuration>
                    </execution>

                    <!-- Build and minify static files -->
                    <execution>
                        <id>run build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <failOnError>false</failOnError>
                    <filesets>
                        <fileset>
                            <directory>${basedir}/frontend/.quasar</directory>
                            <includes>
                                <include>**</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${basedir}/src/main/resources/static</directory>
                            <includes>
                                <include>**</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${basedir}/frontend/node</directory>
                            <includes>
                                <include>**</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${basedir}/frontend/node_modules</directory>
                            <includes>
                                <include>**</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!--
                The executable jar, beside the plain one rather than in place of it.

                `repackage` with a classifier writes target/embabel-smith-studio-<version>-exec.jar
                and leaves the main artifact as it was, so `java -jar` works without changing what
                `mvn install` publishes — which matters because poc/poc-27 depends on this module as
                a library, and a repackaged jar keeps its classes under BOOT-INF/classes where an
                ordinary classpath cannot see them.

                This is the jar the container image runs. It is only a correct artifact because the
                frontend executions above run before the resources copy: the SPA has to be inside
                BOOT-INF/classes/static, and an executable jar of a module whose static bundle was
                generated after the copy would boot and 404 at /.

                The version comes from the root pom's <pluginManagement>, and the Start-Class is
                detected — SmithStudioApplication is the module's only main().
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
